// For format details, see https://aka.ms/devcontainer.json. For config options, see the README at:
// https://github.com/microsoft/vscode-dev-containers/tree/v0.234.0/containers/docker-existing-dockerfile
{
	"name": "IKEM Worker",

	// Sets the run context to one level up instead of the .devcontainer folder.
	"context": "..",

	// Update the 'dockerFile' property if you aren't using the standard 'Dockerfile' filename.
	"dockerFile": "../docker/worker/Dockerfile",

	// Set *default* container specific settings.json values on container create.
	"settings": { },
	
	// Add the IDs of extensions you want installed when the container is created.
	"extensions": [
		"wayou.vscode-icons-mac", "ms-toolsai.jupyter", "ms-python.python", "GitLab.gitlab-workflow"
	],

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	"containerEnv": {
		"REDIS_HOST": "10.0.50.30",
		"REDIS_PORT": "6379",
		"IEDL_ROOT_DIR": "/iedl_root_dir",
  
		// These are not relevant... grr
		"UVICORN_PORT": "8000",
		"UVICORN_HOST": "0.0.0.0",
		"UVICORN_WORKERS": "1",
		"PG_PORT": "5432",
		"PG_HOST": "vgg_histo_db",
		"PG_USER": "iedl_user",
		"PG_DB": "iedl_db",
		"ALGORITHM": "HS256",
		"ACCESS_TOKEN_EXPIRE_MINUTES": "30",
		"RELOAD": "False",
		"APP_NAME": "iedl-api",
		"LOG_LEVEL": "debug",
		"DEPLOY": "dev"
	},

	// Uncomment when using a ptrace-based debugger like C++, Go, and Rust
	"runArgs": [ 
		"--gpus", "all", "--privileged",
		"--network=bridge",
		"--shm-size", "8g",
		"-e", "CUDA_VISIBLE_DEVICES=1",
		"-e", "PYTHONPATH=/workspace/${localWorkspaceFolderBasename}/src",

		// Volumes
		"-v", "/mnt/iedl_root_dir:/iedl_root_dir",
		"-v", "/mnt/iedl_root_dir:/workspace/${localWorkspaceFolderBasename}/iedl_root_dir"
	],

	"mounts": [ 
        // Git & Other credentials
		"source=${localEnv:HOME}/.gitconfig,target=/root/.gitconfig,type=bind,readonly"
	],

	// Uncomment to use the Docker CLI from inside the container. See https://aka.ms/vscode-remote/samples/docker-from-docker.
	// "mounts": [ "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind" ]

	"workspaceMount": "source=${localWorkspaceFolder},target=/workspace/${localWorkspaceFolderBasename},type=bind",
	"workspaceFolder": "/workspace/${localWorkspaceFolderBasename}"
}
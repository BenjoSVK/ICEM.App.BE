IEDL_ROOT_DIR=/iedl_root_dir
RELOAD=False

APP_NAME=iedl-api
LOG_LEVEL=debug

UVICORN_PORT=8000
UVICORN_HOST=0.0.0.0
UVICORN_WORKERS=1

# Comma-separated list of allowed CORS origins (e.g. https://app.example.com). Default is *
CORS_ORIGINS=http://localhost:3000

REDIS_HOST=localhost
REDIS_PORT=6379

PG_PORT=5432
PG_HOST=localhost
PG_USER=postgres
PG_PASSWORD=your_postgres_password_here
PG_DB=mydatabase

SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7